NODE_ENV=production
PORT=4000
WEB_ORIGIN=https://your-site.com
BEHIND_CLOUDFLARE=true
DATABASE_URL=postgresql://topup:topup@localhost:5432/topup
REDIS_URL=redis://localhost:6379
# 64 random chars each:  openssl rand -hex 32
JWT_SECRET=
ENCRYPTION_KEY=              # exactly 64 hex chars (32 bytes) - encrypts MFA secrets
LOOKUP_TOKEN_SECRET=
WEBHOOK_HMAC_SECRET=
WEBHOOK_REQUIRE_SIGNATURE=true
# ABA PayWay (from your merchant profile)
PAYWAY_BASE_URL=https://checkout-sandbox.payway.com.kh
PAYWAY_MERCHANT_ID=
PAYWAY_API_KEY=
PAYWAY_CALLBACK_URL=https://api.your-site.com/api/webhooks/payway
PAYWAY_CURRENCY=USD
# Supplier / publisher API hosts you are contractually allowed to call (SSRF allowlist)
SUPPLIER_HOST_ALLOWLIST=api.your-supplier.com
# Secrets referenced from game configs as ${ENV:SUPPLIER_...}
SUPPLIER_API_KEY=
GOOGLE_CLIENT_ID=
TELEGRAM_BOT_TOKEN=
# first admin (used only by db:seed)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
